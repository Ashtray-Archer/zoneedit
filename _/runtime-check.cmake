cmake_minimum_required(VERSION 3.22)
if(NOT DEFINED BUILD OR NOT EXISTS "${BUILD}/zoneedit-mobile.apk")
  message(FATAL_ERROR "BUILD must name the finished native APK directory")
endif()
if(NOT DEFINED ADB)
  set(ADB adb)
endif()
file(MAKE_DIRECTORY "${BUILD}/runtime")
set(out "${BUILD}/runtime")
function(adb output)
  execute_process(COMMAND "${ADB}" ${ARGN} RESULT_VARIABLE status OUTPUT_VARIABLE value ERROR_VARIABLE error TIMEOUT 90)
  file(WRITE "${out}/${output}.txt" "${value}${error}")
  if(NOT status EQUAL 0)
    execute_process(COMMAND "${ADB}" logcat -d -b crash OUTPUT_FILE "${out}/failure-crashes.txt" TIMEOUT 15)
    execute_process(COMMAND "${ADB}" logcat -d -t 4000 OUTPUT_FILE "${out}/failure-system-log.txt" TIMEOUT 15)
    execute_process(COMMAND "${ADB}" shell dumpsys activity exit-info es.isomorphism.zoneedit OUTPUT_FILE "${out}/failure-exit-info.txt" TIMEOUT 15)
    execute_process(COMMAND "${ADB}" logcat -d -s ZoneEdit:I OUTPUT_FILE "${out}/failure-callbacks.txt" TIMEOUT 15)
    execute_process(COMMAND "${ADB}" shell dumpsys activity activities OUTPUT_FILE "${out}/failure-activities.txt" TIMEOUT 15)
    message(FATAL_ERROR "Android ${output} failed: ${value}${error}")
  endif()
  set(${output} "${value}" PARENT_SCOPE)
endfunction()
adb(fingerprint shell getprop ro.build.fingerprint)
adb(abis shell getprop ro.product.cpu.abilist)
adb(log_clear logcat -c)
adb(install install -r "${BUILD}/zoneedit-mobile.apk")
adb(launch shell am start -W -n es.isomorphism.zoneedit/.MainActivity)
execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 20)
adb(process shell pidof es.isomorphism.zoneedit)
adb(ui_dump shell uiautomator dump /sdcard/zoneedit.xml)
adb(ui pull /sdcard/zoneedit.xml "${out}/ui.xml")
file(READ "${out}/ui.xml" ui)
string(FIND "${ui}" "android.webkit.WebView" webview)
if(webview EQUAL -1)
  message(FATAL_ERROR "Launched activity did not expose a WebView")
endif()
execute_process(COMMAND "${ADB}" exec-out screencap -p OUTPUT_FILE "${out}/launch.png" RESULT_VARIABLE status)
if(NOT status EQUAL 0)
  message(FATAL_ERROR "Screenshot capture failed")
endif()
# The real header logo links to /home/, which redirects an unauthenticated
# session to login.php. Exercise the native override on that real redirect.
adb(home_link shell input tap 200 120)
execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 10)
adb(redirect_callbacks logcat -d -s ZoneEdit:I)
string(FIND "${redirect_callbacks}" "navigation_decision action=1 redirect=1" redirect)
if(redirect EQUAL -1)
  message(FATAL_ERROR "The real unauthenticated home redirect did not reach the native URL guard")
endif()
adb(redirect_dump shell uiautomator dump /sdcard/zoneedit-redirect.xml)
adb(redirect_ui pull /sdcard/zoneedit-redirect.xml "${out}/redirect-ui.xml")
file(READ "${out}/redirect-ui.xml" ui)
set(password_seen FALSE)
set(login_seen FALSE)
set(form "${ui}")
foreach(attempt RANGE 0 8)
  string(REGEX MATCH "<node[^>]*class=\"android.widget.EditText\"[^>]*password=\"true\"[^>]*bounds=\"\\[([0-9]+),([0-9]+)\\]\\[([0-9]+),([0-9]+)\\]\"" password_node "${form}")
  if(password_node AND CMAKE_MATCH_3 GREATER CMAKE_MATCH_1 AND CMAKE_MATCH_4 GREATER CMAKE_MATCH_2)
    set(password_seen TRUE)
  endif()
  string(REGEX MATCH "<node[^>]*resource-id=\"login\"[^>]*class=\"android.widget.Button\"[^>]*bounds=\"\\[([0-9]+),([0-9]+)\\]\\[([0-9]+),([0-9]+)\\]\"" login_node "${form}")
  if(login_node AND CMAKE_MATCH_3 GREATER CMAKE_MATCH_1 AND CMAKE_MATCH_4 GREATER CMAKE_MATCH_2)
    set(login_seen TRUE)
  endif()
  file(APPEND "${out}/form-visibility.txt" "swipes=${attempt} password_visible=${password_seen} login_visible=${login_seen}\n")
  if(password_seen AND login_seen)
    break()
  endif()
  adb(scroll_login shell input swipe 540 1500 540 650 400)
  execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 1)
  adb(form_dump shell uiautomator dump /sdcard/zoneedit-form.xml)
  adb(form_ui pull /sdcard/zoneedit-form.xml "${out}/form-ui.xml")
  file(READ "${out}/form-ui.xml" form)
endforeach()
execute_process(COMMAND "${ADB}" exec-out screencap -p OUTPUT_FILE "${out}/login-form.png" RESULT_VARIABLE status)
if(NOT status EQUAL 0)
  message(FATAL_ERROR "Login form screenshot failed")
endif()
adb(rotation_off shell settings put system accelerometer_rotation 0)
adb(rotation_landscape shell settings put system user_rotation 1)
execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 8)
adb(rotation_portrait shell settings put system user_rotation 0)
execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 8)
adb(after_recreation shell pidof es.isomorphism.zoneedit)
foreach(cycle RANGE 1 3)
adb(home shell input keyevent 3)
execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 2)
adb(kill shell am force-stop es.isomorphism.zoneedit)
set(stopped FALSE)
foreach(attempt RANGE 1 30)
  execute_process(COMMAND "${ADB}" shell pidof es.isomorphism.zoneedit
    RESULT_VARIABLE running OUTPUT_VARIABLE remaining TIMEOUT 10)
  if(running EQUAL 1)
    set(stopped TRUE)
    break()
  elseif(NOT running EQUAL 0)
    message(FATAL_ERROR "Could not observe background process termination")
  endif()
  execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 0.5)
endforeach()
if(NOT stopped)
  message(FATAL_ERROR "force-stop did not terminate the process; reopening was not exercised")
endif()
adb(reopen shell am start -W -n es.isomorphism.zoneedit/.MainActivity)
execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 8)
adb(after_reopen shell pidof es.isomorphism.zoneedit)
if(after_reopen STREQUAL after_recreation)
  message(FATAL_ERROR "Reopening did not create a new application process")
endif()
adb(exit_info_${cycle} shell dumpsys activity exit-info es.isomorphism.zoneedit)
file(APPEND "${out}/reopen-cycles.txt" "cycle=${cycle} pid=${after_reopen}")
set(after_recreation "${after_reopen}")
endforeach()
foreach(attempt RANGE 1 5)
  adb(back shell input keyevent 4)
  execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 2)
  adb(back_callbacks logcat -d -s ZoneEdit:I)
  string(FIND "${back_callbacks}" "activity_back history=0" root_back)
  if(NOT root_back EQUAL -1)
    break()
  endif()
endforeach()
if(root_back EQUAL -1)
  message(FATAL_ERROR "Android Back never reached the native root-history callback")
endif()
adb(back_state shell dumpsys activity activities)
if(back_state MATCHES "mResumedActivity:[^\n]*es.isomorphism.zoneedit")
  message(FATAL_ERROR "Root Back did not leave the Activity")
endif()
adb(callbacks logcat -d -s ZoneEdit:I)
adb(crashes logcat -d -b crash)
string(FIND "${crashes}" "es.isomorphism.zoneedit" target_crash)
if(NOT target_crash EQUAL -1)
  message(FATAL_ERROR "Target application crashed; inspect runtime/crashes.txt")
endif()
foreach(required "activity_create restored=0" "activity_save" "activity_create restored=1" "mobile_style_queued")
  string(FIND "${callbacks}" "${required}" found)
  if(found EQUAL -1)
    message(FATAL_ERROR "Missing runtime callback evidence: ${required}")
  endif()
endforeach()
if(NOT password_seen OR NOT login_seen)
  message(FATAL_ERROR "Live password field and login button were not visibly reached; inspect form UI/screenshots")
endif()
adb(replacement install -r "${BUILD}/zoneedit-mobile.apk")
file(SHA256 "${BUILD}/zoneedit-mobile.apk" digest)
file(WRITE "${out}/receipt.txt"
  "APK_SHA256 ${digest}\nemulator_install PASS\nActivity_and_WebView PASS\nreal_login_form PASS\nreal_home_redirect PASS\nvirtual_native_callbacks PASS\nrecreation_restore PASS\nreopening PASS\nroot_Back PASS\nreplacement_install PASS\nCSS_evaluation_queued PASS\nCSS_visual_review REQUIRED\nphysical_A1 NOT_RUN\nphysical_C67 NOT_RUN\nauthenticated_DNS_edit NOT_RUN\n")

cmake_minimum_required(VERSION 3.22)
set(receipt "${BUILD}/build-receipt.txt")
file(WRITE "${receipt}" "ZONEEDIT_NATIVE_BUILD\t1\n")
function(revision name path)
  execute_process(COMMAND git -C "${path}" rev-parse HEAD
    RESULT_VARIABLE status OUTPUT_VARIABLE head OUTPUT_STRIP_TRAILING_WHITESPACE)
  if(NOT status EQUAL 0)
    message(FATAL_ERROR "Missing ${name} source identity")
  endif()
  execute_process(COMMAND git -C "${path}" status --porcelain --untracked-files=no
    RESULT_VARIABLE status OUTPUT_VARIABLE dirty OUTPUT_STRIP_TRAILING_WHITESPACE)
  if(NOT status EQUAL 0)
    message(FATAL_ERROR "Could not inspect ${name} source state")
  endif()
  if(dirty STREQUAL "")
    set(state CLEAN)
  else()
    set(state DIRTY)
  endif()
  file(APPEND "${receipt}" "source\t${name}\t${head}\t${state}\n")
endfunction()
revision(application "${SOURCE}")
revision(Idric "${IDRIC_SUPPORT}")
revision(dex "${DEX_REPO}")
revision(ai-ci "${AICI_REPO}")
file(SHA256 "${BUILD}/zoneedit-mobile.apk" apk_digest)
file(SIZE "${BUILD}/zoneedit-mobile.apk" apk_size)
file(SHA256 "${BUILD}/apk/classes.dex" dex_digest)
file(APPEND "${receipt}"
  "package\tes.isomorphism.zoneedit\nversion_code\t2\nAPK_SHA256\t${apk_digest}\nAPK_bytes\t${apk_size}\nDEX_SHA256\t${dex_digest}\nNDK\t27.2.12479018\nSDK\t35\nbuild_tools\t35.0.0\nphysical_A1\tNOT_RUN\nphysical_C67\tNOT_RUN\nauthenticated_DNS_edit\tNOT_RUN\n")

cmake_minimum_required(VERSION 3.22)
function(capture output)
  execute_process(COMMAND ${ARGN} RESULT_VARIABLE status OUTPUT_VARIABLE value ERROR_VARIABLE error)
  if(NOT status EQUAL 0)
    message(FATAL_ERROR "APK verification failed: ${error}")
  endif()
  set(${output} "${value}" PARENT_SCOPE)
endfunction()
capture(certificate "${TOOLS}/apksigner" verify --verbose --print-certs "${APK}")
string(REGEX MATCHALL "certificate SHA-256 digest: [0-9a-f]+" certificates "${certificate}")
list(LENGTH certificates signer_count)
if(NOT signer_count EQUAL 1)
  message(FATAL_ERROR "APK must have exactly one signer")
endif()
list(GET certificates 0 signer)
string(REPLACE "certificate SHA-256 digest: " "" signer "${signer}")
capture(badging "${TOOLS}/aapt2" dump badging "${APK}")
string(REGEX MATCH "package: name='([^']+)'" package_match "${badging}")
set(package "${CMAKE_MATCH_1}")
if(NOT package STREQUAL "es.isomorphism.zoneedit")
  message(FATAL_ERROR "Unexpected APK package: ${package}")
endif()
capture(compile "${NDK}/clang" --target=x86_64-linux-gnu --sysroot=/ -fuse-ld=lld
  -std=c17 -Wall -Wextra -Werror "${AICI_DIR}/src/aici_android_signing.c" -o aici-signing)
capture(verdict ./aici-signing verify "${AICI_DIR}/android-signing/identities.tsv" "${package}" test "${signer}")
file(WRITE signer-receipt.txt "${verdict}")
message(STATUS "${verdict}")
